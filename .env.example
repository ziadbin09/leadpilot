# Copy this file to .env and put your own values in .env. Never commit .env.
# Works with any OpenAI-compatible provider. Defaults below are for Google Gemini.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-key-here
LLM_MODEL=gemini-2.5-flash

# Optional: real Google Calendar. Leave empty to use the built-in demo calendar.
GOOGLE_CREDENTIALS_FILE=
